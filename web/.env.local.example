# 회사 계정(Google Workspace) SSO 설정 — 이 파일을 복사해 .env.local 로 만들고 값을 채우세요.
# .env.local 은 gitignore 됩니다(비밀값을 커밋/채팅에 올리지 마세요).

# 세션 암호화 키. 아래 명령으로 생성: npx auth secret  (또는 openssl rand -base64 32)
AUTH_SECRET=

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID(웹 애플리케이션)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 허용 회사 이메일 도메인(쉼표로 복수 지정 가능). 미지정 시 neolab.net.
ALLOWED_EMAIL_DOMAINS=neolab.net

# SSO 화면 전환: 1이면 로그인 화면이 "회사 Google 계정으로 로그인" 버튼으로 바뀝니다.
# 반드시 AUTH_GOOGLE_ID/SECRET 를 채운 뒤에 1로 켜세요(자격증명 없이 켜면 오류).
NEXT_PUBLIC_SSO=0

# 회사 계정 자동 로그인: 1이면 로그인 페이지 진입 시 자동으로 Google 로그인 시작(승인 불필요).
NEXT_PUBLIC_AUTOLOGIN=0

# 배포 시 실제 앱 URL(로컬은 생략 가능). 예: https://ncodecenter.neolab.net
# NEXTAUTH_URL=http://localhost:3000
